{$DOMAIN} {
	encode gzip

	# REST API
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Django admin
	handle /admin/* {
		reverse_proxy backend:8000
	}

	# Django 静态资源(admin 后台样式,由 WhiteNoise 提供)
	handle /static/* {
		reverse_proxy backend:8000
	}

	# WebSocket (Channels / daphne)
	handle /ws/* {
		reverse_proxy ws:8001
	}

	# SPA 前端:静态资源 + 路由回退
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}

# 说明:Caddy 自动为公网域名申请/续期 Let's Encrypt 证书;
# 当 DOMAIN=localhost 时自动改用内置自签 CA。如需指定 ACME 邮箱,
# 可在此 site 块内加一行 `tls {$ACME_EMAIL}`(仅公网域名且邮箱非空时)。

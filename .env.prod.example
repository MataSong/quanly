# ============================================================
# Quanly 生产环境配置模板
# 用法:复制为 .env.prod,按注释填写真实值,切勿提交到版本库。
# 启动:docker compose --env-file .env.prod up -d --build
# ============================================================

# --- Django 核心 ---
# 强随机串,生成:python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME-strong-random-50-chars
# 生产必须为 0(关闭调试页、不泄露堆栈)
DJANGO_DEBUG=0
# 你的域名(逗号分隔,不要用 *)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# --- 密钥加密(用户 OKX API 密钥的加密主密钥)---
# 必须换新!生成:python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 注意:一旦设定不要再改,否则已存的用户密钥无法解密。
SECRET_ENCRYPTION_KEY=CHANGE-ME-generate-a-new-fernet-key

# --- PostgreSQL ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=quanly
DB_USER=quanly
DB_PASSWORD=CHANGE-ME-strong-db-password
DB_HOST=postgres
DB_PORT=5432

# --- InfluxDB(行情时序库)---
INFLUX_USER=quanly
INFLUX_PASSWORD=CHANGE-ME-strong-influx-password
INFLUX_ADMIN_TOKEN=CHANGE-ME-strong-influx-token
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=quanly
INFLUX_BUCKET=market

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- OKX 同步间隔(秒):celery-beat 定时全量校正余额/持仓 ---
OKX_SYNC_INTERVAL=20

# --- Caddy 自动 HTTPS(生产 deploy/init.sh 会自动写入)---
# DOMAIN=your-domain.com
# ACME_EMAIL=you@example.com

# 数据源已固定走 OKX 官方接口(模拟盘 flag=1 / 实盘 flag=0,按用户所选 env 自动区分)。
# 前提提醒:服务器必须能访问 OKX(先验证 curl https://www.okx.com/api/v5/public/time)。
# 用户需在「API 密钥」页填写真实/demo 的 OKX Key/Secret/Passphrase 后方可交易。

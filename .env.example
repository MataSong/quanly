# ================================================================
# quanly .env.example — 拷贝为 .env 并填写真实值
# 注意：.env 含真实密钥，不入 git；此 .env.example 可入库
# ================================================================

# ----- Django 运行环境 -----
QUANLY_ENV=prod

# JWT / Session 签名密钥（生产必须设置，prod.py 有 assert）
QUANLY_SECRET_KEY=change-me-to-a-long-random-string

# OKX 密钥 Fernet 加密主密钥（生产必须设置，prod.py 有 assert）
# 生成命令: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
QUANLY_CREDENTIALS_ENC_KEY=change-me-fernet-key

# 允许的 Host 头（* = 放开所有 IP 访问；或逗号分隔指定 localhost,域名,IP）
QUANLY_ALLOWED_HOSTS=*

# CORS（前端独立部署时填写；nginx 同源不需要）
QUANLY_CORS_ALLOWED_ORIGINS=

# ----- PostgreSQL -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=quanly
POSTGRES_USER=quanly
POSTGRES_PASSWORD=change-me-db-password

# ----- 种子超管账号 -----
QUANLY_ADMIN_USER=admin
QUANLY_ADMIN_PASSWORD=change-me-admin-password
QUANLY_ADMIN_EMAIL=admin@quanly.local

# ----- nginx 对外端口（默认 80）-----
NGINX_PORT=80

# ----- Gunicorn 并发 worker 数（默认 2）-----
GUNICORN_WORKERS=2

# ----- 下一阶段预留 -----
# REDIS_URL=redis://redis:6379/0
# QUANLY_JWT_SIGNING_KEY=separate-jwt-key
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=
# OKX_SIMULATED=true

# 复制为 .env.test(测试)或 .env.prod(生产),按环境填值。
# 启动:docker compose --env-file .env.test up -d --build
# 生产:docker compose --env-file .env.prod up -d --build
# 同一套镜像,只换 --env-file,镜像本体不变。

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
ALLOWED_HOSTS=your-domain.com

# Fernet 密钥,用以下命令生成:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=generate-a-fernet-key

DB_ENGINE=django.db.backends.postgresql
DB_NAME=quanly
DB_USER=quanly
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

INFLUX_USER=quanly
INFLUX_PASSWORD=change-me
